# ==============================================================================
# ReThread AI — Environment Configuration
# ==============================================================================

# Stability AI API Key (Recommended for high-fidelity clothing redesigns)
# Get your API key at: https://platform.stability.ai/account/keys
STABILITY_API_KEY=your_stability_api_key_here

# Optional: Replicate API Token (Alternative image-to-image provider)
# Get your token at: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Optional: Server Port & Host Configuration
PORT=8000
HOST=0.0.0.0

# Upload constraints
MAX_IMAGE_SIZE_MB=10
